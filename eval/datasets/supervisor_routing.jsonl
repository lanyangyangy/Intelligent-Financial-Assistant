{"id": "SR-001", "category": "supervisor_routing", "kind": "route", "name": "客户角色统一路由到客服", "input": "帮我查一下我的资产", "params": {"is_customer": true}, "expected": ["customer_service"], "mode": "exact", "hard_gate": false, "notes": "客户账号只能使用智能客服 Agent（需求文档 2.2）"}
{"id": "SR-002", "category": "supervisor_routing", "kind": "route", "name": "申购指令路由到业务操作", "input": "帮客户申购10万元稳健债券", "params": {"employee_role": "customer_manager"}, "expected": ["business_operator"], "mode": "exact", "hard_gate": true, "notes": "执行类操作必须路由业务操作 Agent"}
{"id": "SR-003", "category": "supervisor_routing", "kind": "route", "name": "投顾推荐路由到投顾助手", "input": "请为李伟推荐合适的理财配置", "params": {"employee_role": "financial_advisor"}, "expected": ["investment_advisor"], "mode": "exact", "hard_gate": false, "notes": "投顾推荐只对理财顾问开放"}
{"id": "SR-004", "category": "supervisor_routing", "kind": "route", "name": "风控扫描路由到风控监测", "input": "风控扫描一下客户的交易记录", "params": {"employee_role": "risk_specialist"}, "expected": ["risk_monitor"], "mode": "exact", "hard_gate": false, "notes": "风控语境优先，避免被数据分析关键词抢走"}
{"id": "SR-005", "category": "supervisor_routing", "kind": "route", "name": "数据分析统计路由到数据分析", "input": "统计一下客户总数和AUM分布", "params": {"employee_role": "customer_manager"}, "expected": ["data_analyst"], "mode": "exact", "hard_gate": false, "notes": "NL2SQL 仅内部员工可用"}
{"id": "SR-006", "category": "supervisor_routing", "kind": "route", "name": "高净值客户净值咨询不误路由", "input": "高净值客户想看产品净值是多少", "params": {"is_customer": true}, "expected": ["customer_service"], "mode": "exact", "hard_gate": true, "notes": "裸「净值」不触发业务操作，防止高净值画像误命中"}
{"id": "SR-007", "category": "supervisor_routing", "kind": "route", "name": "纯确认文本路由到业务操作", "input": "确认", "params": {"employee_role": "customer_manager"}, "expected": ["business_operator"], "mode": "exact", "hard_gate": false, "notes": "二次确认响应词消费会话待确认操作"}
{"id": "SR-008", "category": "supervisor_routing", "kind": "route", "name": "越权申购不回退数据分析", "input": "帮客户申购10万元稳健债券", "params": {"employee_role": "risk_specialist"}, "expected": ["business_operator"], "mode": "exact", "hard_gate": true, "notes": "越权角色命中 STRICT_OPERATION 必须明确拒绝（403），不回退 NL2SQL 造成误导"}
{"id": "SR-009", "category": "supervisor_routing", "kind": "route", "name": "纯闲聊走客服兜底", "input": "你好，今天天气不错", "params": {"employee_role": "customer_manager"}, "expected": ["customer_service"], "mode": "exact", "hard_gate": false, "notes": "闲聊不触发业务兜底"}
{"id": "SR-010", "category": "supervisor_routing", "kind": "route", "name": "贷款办理触发业务兜底", "input": "帮我办理一笔贷款", "params": {"employee_role": "customer_manager"}, "expected": ["business_operator"], "mode": "exact", "hard_gate": false, "notes": "未覆盖业务触发「目前没有该业务」兜底"}
{"id": "SR-011", "category": "supervisor_routing", "kind": "route", "name": "客户咨询理财产品走客服", "input": "你们有哪些理财产品", "params": {"is_customer": true}, "expected": ["customer_service"], "mode": "exact", "hard_gate": false, "notes": "客户账号只能使用智能客服"}
{"id": "SR-012", "category": "supervisor_routing", "kind": "route", "name": "客户询问购买流程走客服", "input": "如何购买理财产品", "params": {"is_customer": true}, "expected": ["customer_service"], "mode": "exact", "hard_gate": false, "notes": "咨询类问题路由客服 RAG"}
{"id": "SR-013", "category": "supervisor_routing", "kind": "route", "name": "投顾配置建议路由投顾", "input": "请推荐适合李伟的资产配置", "params": {"employee_role": "financial_advisor"}, "expected": ["investment_advisor"], "mode": "exact", "hard_gate": false, "notes": "推荐/配置/持仓词触发投顾助手"}
{"id": "SR-014", "category": "supervisor_routing", "kind": "route", "name": "工单状态查询路由数据分析", "input": "帮我查一下工单状态", "params": {"employee_role": "customer_manager"}, "expected": ["data_analyst"], "mode": "exact", "hard_gate": false, "notes": "工单查询属数据分析 NL2SQL，先于业务操作词判断"}
{"id": "SR-015", "category": "supervisor_routing", "kind": "route", "name": "当前持仓查询路由数据分析", "input": "查一下李伟当前持仓", "params": {"employee_role": "customer_manager"}, "expected": ["data_analyst"], "mode": "exact", "hard_gate": false, "notes": "当前持仓命中 ANALYTICS_QUERY_WORDS"}
{"id": "SR-016", "category": "supervisor_routing", "kind": "route", "name": "取消响应路由业务操作", "input": "取消", "params": {"employee_role": "customer_manager"}, "expected": ["business_operator"], "mode": "exact", "hard_gate": false, "notes": "确认/取消响应词消费待确认操作"}
{"id": "SR-017", "category": "supervisor_routing", "kind": "route", "name": "收益率统计路由数据分析", "input": "今天各产品的收益率怎么样", "params": {"employee_role": "financial_advisor"}, "expected": ["data_analyst"], "mode": "exact", "hard_gate": false, "notes": "收益率词触发 NL2SQL"}
{"id": "SR-018", "category": "supervisor_routing", "kind": "route", "name": "办卡业务触发业务兜底", "input": "帮我办一张信用卡", "params": {"employee_role": "customer_manager"}, "expected": ["business_operator"], "mode": "exact", "hard_gate": false, "notes": "办卡命中 BUSINESS_CONTEXT_WORDS 且非问句"}
{"id": "SR-019", "category": "supervisor_routing", "kind": "route", "name": "客户转账诉求走客服", "input": "我要转账", "params": {"is_customer": true}, "expected": ["customer_service"], "mode": "exact", "hard_gate": false, "notes": "客户不能直接执行业务操作，走客服引导"}
{"id": "SR-020", "category": "supervisor_routing", "kind": "route", "name": "AUM 统计路由数据分析", "input": "统计一下客户的AUM分布", "params": {"employee_role": "financial_advisor"}, "expected": ["data_analyst"], "mode": "exact", "hard_gate": false, "notes": "统计/AUM 触发 NL2SQL"}
